  fl_t <- flashier::flash_init(t(Y), var_type = 0)
  fl_t <- flashier::flash_greedy(fl_t, Kmax = 2, init_fn = init_t,
                                 ebnm_fn = list(ebnm::ebnm_point_normal, prior_L))
