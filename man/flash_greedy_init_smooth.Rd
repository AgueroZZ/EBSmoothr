  fl_nn <- flashier::flash_init(Y, var_type = 0)
  fl_nn <- flashier::flash_greedy(fl_nn, Kmax = 2, init_fn = init_nn,
                                  ebnm_fn = list(prior_L, ebnm::ebnm_point_exponential))

  # Smooth factors instead of loadings (time along the columns):
